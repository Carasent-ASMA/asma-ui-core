{
    "name": "asma-ui-core",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.0.1",
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "files": [
        "dist/**/*",
        "dist/style.css",
        "tw-configs/**/*",
        "src/styles/**/*"
    ],
    "keywords": [],
    "author": "asma-team",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "icons": [
                "dist/src/components/icons/index.d.ts"
            ],
            "icons/*": [
                "dist/src/components/icons/*/index.d.ts"
            ]
        }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./icons": {
            "types": "./dist/src/components/icons/index.d.ts",
            "default": "./dist/components/icons/index.js"
        },
        "./icons/*": {
            "types": "./dist/src/components/icons/*/index.d.ts",
            "default": "./dist/components/icons/*/index.js"
        },
        "./dist/style.css": "./dist/style.css",
        "./tw-configs/twConfigs.json": "./tw-configs/twConfigs.json",
        "./src/styles/breakpoints": "./src/styles/_breakpoints.scss"
    },
    "scripts": {
        "chromatic": "npx chromatic --config-file chromatic.config.json",
        "dev": "vite",
        "build": "pnpm ts:check && rm -rf ./dist && vite build",
        "ts:check": "tsc",
        "preview": "vite preview",
        "lint": "eslint src/**/*.{ts,tsx} --cache",
        "version": "echo $npm_package_version",
        "lint:fix": "eslint --fix src/**/*.{ts,tsx}",
        "return:types": "tsx scripts/add-missing-return-types.ts",
        "storybook": "storybook dev -p 6006",
        "storybook:no-browser": "storybook dev -p 6006 --no-open",
        "build-storybook": "export NODE_OPTIONS=--max_old_space_size=6240 && storybook build",
        "vrt": "bash scripts/vrt.sh check",
        "vrt:accept": "bash scripts/vrt.sh accept",
        "vrt:report": "playwright show-report",
        "test-storybook": "npx vitest --project=storybook",
        "changeset:pre-beta": "changeset pre enter beta",
        "changeset:pre-exit": "changeset pre exit",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "changeset:status": "changeset status"
    },
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24 <25"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/modifiers": "^7.0.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@floating-ui/react": "^0.27.19",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.21",
        "clsx": "^1.2.1",
        "date-fns": "^3.6.0",
        "notistack": "^3.0.2",
        "react-day-picker": "^9.14.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.26.2",
        "@chromatic-com/storybook": "^5.1.1",
        "@eslint/js": "^9.39.2",
        "@faker-js/faker": "^8.0.2",
        "@playwright/test": "1.60.0",
        "@storybook/addon-a11y": "10.3.3",
        "@storybook/addon-docs": "10.3.3",
        "@storybook/addon-links": "10.3.3",
        "@storybook/addon-themes": "^10.3.3",
        "@storybook/addon-vitest": "10.3.3",
        "@storybook/react-vite": "10.3.3",
        "@tippyjs/react": "^4.2.6",
        "@types/node": "^24.12.4",
        "@types/react": "^18.3.23",
        "@types/react-copy-to-clipboard": "^5.0.7",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/browser-playwright": "^4.0.16",
        "autoprefixer": "^10.4.27",
        "chromatic": "^13.3.4",
        "eslint": "^9.39.2",
        "eslint-plugin-better-tailwindcss": "^3.8.0",
        "eslint-plugin-de-morgan": "^2.0.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-you-might-not-need-an-effect": "^0.7.0",
        "eslint-plugin-regexp": "^2.10.0",
        "eslint-plugin-storybook": "10.3.3",
        "playwright": "^1.57.0",
        "react": "^18.3.1",
        "react-copy-to-clipboard": "^5.1.0",
        "react-dom": "^18.3.1",
        "react-hot-toast": "^2.4.1",
        "sass": "^1.98.0",
        "storybook": "10.3.3",
        "storybook-addon-pseudo-states": "^10.3.3",
        "tailwind-scrollbar": "^3.1.0",
        "tailwindcss": "^3.3.2",
        "ts-morph": "^27.0.2",
        "tsx": "^4.21.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.50.0",
        "typescript-plugin-css-modules": "^5.0.1",
        "vite": "^8.0.3",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.0.16"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Carasent-ASMA/asma-ui-core.git"
    }
}
